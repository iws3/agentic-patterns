# Rename this file to .env and fill in your key.
# The examples use init_chat_model("gpt-4o-mini"), so an OpenAI key is
# the default. Swap the model string and provider package in any
# main.py to use a different provider (Anthropic, Gemini, etc).

OPENAI_API_KEY=your-key-here
GEMINI_API_KEY=your-key-here
